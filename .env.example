# Database — ADR-002 (docs/decisions/ADR-002-postgresql.md)
# Host port 55432 (see docker-compose.yml) — 5432/5433 were already in use
# locally by an unrelated project on this machine.
#
# DATABASE_URL (the "crm" role) is a superuser — that's how the official
# postgres image's POSTGRES_USER always works. Prisma Migrate uses it for
# schema changes. It must NEVER be what the running API connects as: Postgres
# superusers (and table owners, by default) BYPASS Row-Level Security
# entirely, which would silently defeat every RLS policy from
# docs/database/rls-policies.sql (a real bug caught building M2 — see
# docs/database/README.md §5.6). APP_DATABASE_URL (the "crm_app" role,
# created by migration 20260827084203_app_db_role_and_force_rls) is what the
# API actually connects as at runtime — NOSUPERUSER, NOBYPASSRLS.
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:55432/ai_crm?schema=public"
APP_DATABASE_URL="postgresql://crm_app:crm_app_dev_password@localhost:55432/ai_crm?schema=public"

# Redis — cache, rate limiting, BullMQ queue — ADR-006 (docs/decisions/ADR-006-redis-bullmq.md)
# Host port 56379 (see docker-compose.yml) — 6379 was already in use locally
# by an unrelated project on this machine.
REDIS_URL="redis://localhost:56379"

# Auth — FR-001 to FR-005 (docs/srs/04-functional-requirements.md)
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# AI Provider Adapter — ADR-007 (docs/decisions/ADR-007-ai-provider-adapter.md)
# Set the credentials for whichever provider the adapter targets.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# App
# PORT is not 3001 — that's already bound by an unrelated project's API on
# this machine.
NODE_ENV="development"
PORT=34001
WEB_PORT=3000

# Frontend (apps/web) — Next.js only inlines NEXT_PUBLIC_* vars it reads from
# apps/web/.env.local (same per-app-.env quirk as apps/api), not this root file.
NEXT_PUBLIC_API_URL="http://localhost:34001/api/v1"
