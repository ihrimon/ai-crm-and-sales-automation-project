# Database — ADR-002 (docs/decisions/ADR-002-postgresql.md)
# Host port 55432 (see docker-compose.yml) — 5432/5433 were already in use
# locally by an unrelated project on this machine.
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:55432/ai_crm?schema=public"

# Redis — cache, rate limiting, BullMQ queue — ADR-006 (docs/decisions/ADR-006-redis-bullmq.md)
# Host port 56379 (see docker-compose.yml) — 6379 was already in use locally
# by an unrelated project on this machine.
REDIS_URL="redis://localhost:56379"

# Auth — FR-001 to FR-005 (docs/srs/04-functional-requirements.md)
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# AI Provider Adapter — ADR-007 (docs/decisions/ADR-007-ai-provider-adapter.md)
# Set the credentials for whichever provider the adapter targets.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# App
# PORT is not 3001 — that's already bound by an unrelated project's API on
# this machine.
NODE_ENV="development"
PORT=34001
WEB_PORT=3000
