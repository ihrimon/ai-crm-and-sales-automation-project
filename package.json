{
  "name": "ai-crm-sales-automation",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native, automation-first CRM & Sales Automation platform. See docs/README.md for the full SDLC documentation.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev:api": "pnpm --filter @ai-crm/api dev",
    "dev:web": "pnpm --filter @ai-crm/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ai-crm/e2e test",
    "db:generate": "pnpm --filter @ai-crm/api prisma:generate",
    "db:migrate": "pnpm --filter @ai-crm/api prisma:migrate",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.1.1",
      "lodash": ">=4.18.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "postcss@<=8.5.22": ">=8.5.23",
      "tmp@<0.2.6": ">=0.2.6",
      "fast-uri@<3.1.6": ">=3.1.6",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "file-type@>=13.0.0 <21.3.2": ">=21.3.2"
    }
  }
}
